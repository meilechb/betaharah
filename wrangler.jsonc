{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "betaharah",
  "main": "src/app/index.ts",
  "compatibility_date": "2026-11-01",
  // The app is served at betaharah.com only. Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "betaharah.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // The pages in ./public are served as files. The paths listed here always go to the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhooks/*", "/cal/*", "/help", "/privacy", "/terms", "/donate"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "betaharah",
      "database_id": "e6e769d9-dffe-48e9-bb8a-4e1420dc8db8"
    }
  ],
  // Every minute: send the reminders that are due and keep one household's calendar current.
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Errors are logged. The per-request log, which would record every address
  // requested (calendar links included), is turned off.
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  }
}
