{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "betaharah",
  "main": "src/app/index.ts",
  "compatibility_date": "2026-11-01",
  // The app is served at betaharah.com only. Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "betaharah.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // The dashboard page. Requests that match no file (the API and the webhook) go to the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "betaharah",
      "database_id": "e6e769d9-dffe-48e9-bb8a-4e1420dc8db8"
    }
  ],
  // Every 5 minutes: send reminders that are due and keep the calendar current.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
